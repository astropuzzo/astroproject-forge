<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AstroForge.App.ViewModels"
        xmlns:local="using:AstroForge.CrossPlatform.Controls"
        x:Class="AstroForge.CrossPlatform.MainWindow"
        x:CompileBindings="False"
        Title="AstroProject Forge" Icon="/Assets/astroforge.ico" Width="1360" Height="830" MinWidth="1080" MinHeight="680" WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
  <Panel>
  <local:StarfieldBackdrop x:Name="Backdrop"/>
  <Grid x:Name="RootLayout" RowDefinitions="Auto,Auto,*,Auto" Margin="30,20,30,20" MaxWidth="1680">

    <!-- Header: where the project is (the four steps), what it is, and the tools. -->
    <Grid x:Name="TopBar" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="30" MinHeight="70">
      <Button Grid.Column="0" x:Name="MenuButton" Classes="brand" Click="ToggleSettings_Click" ToolTip.Tip="Menu · Ctrl+," VerticalAlignment="Top" MinWidth="44">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Panel Width="34" Height="34">
            <Ellipse Width="34" Height="34" Fill="{StaticResource BrandGlowBrush}"/>
            <Path Data="M17 3 L19 15 L31 17 L19 19 L17 31 L15 19 L3 17 L15 15Z" Fill="White"/>
          </Panel>
          <StackPanel x:Name="BrandText" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="ASTROPROJECT FORGE" FontWeight="Medium" FontSize="12" LetterSpacing="0.7"/>
            <TextBlock Text="per PixInsight WBPP" Classes="muted" FontSize="11"/>
          </StackPanel>
        </StackPanel>
      </Button>

      <local:StepperBar Grid.Column="1" x:Name="Stepper" Steps="{Binding Steps}" MaxWidth="780" HorizontalAlignment="Center" VerticalAlignment="Top"/>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top" HorizontalAlignment="Right">
        <StackPanel x:Name="ProjectChip" VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="230" HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <Ellipse Width="6" Height="6" Fill="{StaticResource OkBrush}" IsVisible="{Binding StateLive}" Classes="live" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StateLabel}" Classes="eyebrow" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{Binding TargetTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
        </StackPanel>
        <Button x:Name="ToolsButton" Classes="cmdk" ToolTip.Tip="Statistiche, qualità, metadati e Libreria Master">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="270" Spacing="2" Margin="-6">
                <TextBlock Text="STRUMENTI" Classes="eyebrow" Margin="10,6,10,6"/>
                <Button Classes="tool" Click="OpenMetadata_Click"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Frame e metadati"/><TextBlock Grid.Column="1" Text="Alt 5" Classes="kbd"/></Grid></Button>
                <Button Classes="tool" Click="OpenStatistics_Click"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Statistiche"/><TextBlock Grid.Column="1" Text="Alt 6" Classes="kbd"/></Grid></Button>
                <Button Classes="tool" Click="OpenQuality_Click"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Qualità dei frame"/><TextBlock Grid.Column="1" Text="Alt 7" Classes="kbd"/></Grid></Button>
                <Button Classes="tool" Click="OpenMasters_Click"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Libreria Master"/><TextBlock Grid.Column="1" Text="Alt 8" Classes="kbd"/></Grid></Button>
                <Border Classes="rule" Margin="10,6"/>
                <Button Classes="tool" Click="OpenDiagnosticsTab_Click"><TextBlock Text="Diagnostica e log"/></Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Path Data="M3 6 H21 M3 12 H21 M3 18 H21" Stroke="{StaticResource MutedBrush}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" StrokeLineCap="Round"/>
            <TextBlock Text="Strumenti" FontSize="12.5"/>
          </StackPanel>
        </Button>
        <Button Classes="cmdk" Click="OpenPalette_Click" ToolTip.Tip="Comandi · Ctrl+K">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Path Data="M10.5 3.5 A7 7 0 1 1 10.49 3.5 Z M15.5 15.5 L21 21" Stroke="{StaticResource MutedBrush}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform"/>
            <Border Classes="kbd"><TextBlock Text="Ctrl K"/></Border>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <ProgressBar Grid.Row="0" VerticalAlignment="Bottom" Margin="0,0,0,-8" Height="2" MinHeight="2" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding IsScanning}"/>

    <!-- What is new: data added to a project that already had some. -->
    <Border Grid.Row="1" x:Name="NoveltyBar" Classes="novelty" IsVisible="{Binding HasNovelty}" Margin="0,12,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
        <Path Data="M12 3 L13.8 10.2 L21 12 L13.8 13.8 L12 21 L10.2 13.8 L3 12 L10.2 10.2Z" Fill="{StaticResource OiiiBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="{Binding NoveltyTitle}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding NoveltyText}" Classes="muted" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button Grid.Column="2" Content="{Binding NoveltyAction}" Classes="primary" Padding="14,5" IsVisible="{Binding !IsExportStep}" Click="NoveltyGoToExport_Click"/>
        <Button Grid.Column="3" Classes="icon" Content="✕" Click="DismissNovelty_Click" ToolTip.Tip="Chiudi le novità: i dati restano nel progetto"/>
      </Grid>
    </Border>

    <!-- One page per step. -->
    <Grid Grid.Row="2" Margin="0,16,0,10">
      <Border x:Name="RecoveryBanner" Classes="warningBanner" IsVisible="{Binding Main.HasRecoverySnapshot}" VerticalAlignment="Top" ZIndex="5" Margin="0,0,0,8"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7"><StackPanel><TextBlock Text="RECUPERO DISPONIBILE" Classes="eyebrow"/><TextBlock Text="{Binding Main.RecoverySummary}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Ripristina" Click="RestoreRecovery_Click"/><Button Grid.Column="2" Content="Ignora" Click="DiscardRecovery_Click"/></Grid></Border>
      <Carousel x:Name="ScreenPages" SelectedIndex="{Binding CurrentStep, Mode=TwoWay}">
        <Carousel.PageTransition><local:SlewPageTransition/></Carousel.PageTransition>

        <!-- 1 · Importa: the Master Library first, then the captures. -->
        <ScrollViewer x:Name="ImportPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,4,0,18" Spacing="24" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
              <TextBlock Text="PASSO 1 DI 4 · IMPORTA" Classes="eyebrow accent"/>
              <TextBlock Text="Cosa vuoi elaborare?" Classes="pageTitle"/>
              <TextBlock Text="Collega le tue calibrazioni una volta sola, poi aggiungi le acquisizioni." Classes="serif note" TextWrapping="Wrap"/>
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="22">
              <Border x:Name="LibraryCard" Classes="card hero step" MinHeight="380">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Classes="badge"><TextBlock Text="1"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="LIBRERIA MASTER" Classes="eyebrow"/><TextBlock Text="Dark e Bias, una volta sola" Classes="stepTitle"/></StackPanel>
                    <Border Grid.Column="2" Classes="count" VerticalAlignment="Top"><TextBlock Text="{Binding Main.MasterLibraryCountLabel}"/></Border>
                  </Grid>
                  <TextBlock Grid.Row="1" Text="Collega la cartella dei tuoi Master Dark e Bias. Forge li abbina per camera, gain, offset e temperatura e li ricorda per ogni progetto." Classes="muted" TextWrapping="Wrap" LineHeight="20"/>
                  <Border Grid.Row="2" x:Name="LibraryDrop" Classes="drop" IsVisible="{Binding NoLibraries}" PointerReleased="LibraryDrop_PointerReleased" MinHeight="220">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                      <Path Data="M12 3 V15 M7 10 L12 15 L17 10 M4 19 H20" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Width="30" Height="30" Stretch="Uniform" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center"/>
                      <Button Content="+ Aggiungi Master Library" Classes="primary" Click="AddLibrary_Click" HorizontalAlignment="Center" ToolTip.Tip="Scegli la cartella con i Master Dark e Bias"/>
                      <TextBlock Text="Non ce l’hai? Salta: la aggiungi quando vuoi." Classes="muted" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Row="2" Spacing="9" IsVisible="{Binding HasLibraries}">
                    <ItemsControl ItemsSource="{Binding Main.MasterLibraries}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Classes="pathCard"><Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                          <CheckBox IsChecked="{Binding Enabled}" ToolTip.Tip="Includi questa libreria nell’analisi" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" Classes="muted" FontSize="10.5" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/></StackPanel>
                          <Border Grid.Column="2" Classes="count" Margin="0"><TextBlock Text="{Binding Status}"/></Border>
                          <Button Grid.Column="3" Classes="icon" Content="↑" Click="MoveLibraryItemUp_Click" ToolTip.Tip="Aumenta priorità"/>
                          <Button Grid.Column="4" Classes="icon" Content="↓" Click="MoveLibraryItemDown_Click" ToolTip.Tip="Riduci priorità"/>
                          <Button Grid.Column="5" Classes="icon" Content="✕" Click="RemoveLibraryItem_Click" ToolTip.Tip="Rimuovi la libreria dall’app senza cancellare i Master"/>
                        </Grid></Border>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                      <Button Content="+ Un’altra libreria" Click="AddLibrary_Click"/>
                      <Button Content="Aggiorna stato" Click="RefreshLibraries_Click"/>
                      <Button Content="Verifica e organizza…" Click="OpenMasters_Click" ToolTip.Tip="Copertura dei Dark, controllo metadati e copie ordinate"/>
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Grid.Column="1" x:Name="SourcesCard" Classes="card hero step" MinHeight="380">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Classes="badge"><TextBlock Text="2"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="ACQUISIZIONI" Classes="eyebrow"/><TextBlock Text="Le immagini del progetto" Classes="stepTitle"/></StackPanel>
                    <Border Grid.Column="2" Classes="count" VerticalAlignment="Top"><TextBlock Text="{Binding Main.SourceSummary}"/></Border>
                  </Grid>
                  <TextBlock Grid.Row="1" Text="Cartelle o file FITS e XISF da ASIAIR, N.I.N.A. o altri software. Forge legge solo gli header: i tuoi file non vengono mai modificati." Classes="muted" TextWrapping="Wrap" LineHeight="20"/>
                  <Border Grid.Row="2" x:Name="SourcesDrop" Classes="drop" IsVisible="{Binding NoSources}" PointerReleased="SourcesDrop_PointerReleased" MinHeight="220">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                      <Path Data="M3 7 H9 L11 9 H21 V19 H3 Z" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Width="30" Height="30" Stretch="Uniform" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center"/>
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Content="+ Importa cartella" Classes="primary" Click="AddSources_Click" ToolTip.Tip="Importa ricorsivamente FITS e XISF"/>
                        <Button Content="+ Singoli file" Click="AddFiles_Click"/>
                      </StackPanel>
                      <Button Content="Prova con il progetto demo" Classes="link" Click="OpenDemo_Click" HorizontalAlignment="Center" ToolTip.Tip="Due notti di FITS sintetici con Flat e Master"/>
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Row="2" Spacing="9" IsVisible="{Binding HasSources}">
                    <ItemsControl ItemsSource="{Binding Main.SourcePaths}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Classes="pathCard"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                          <Border Width="22" Height="22" CornerRadius="6" Classes="iconTile" VerticalAlignment="Center"><TextBlock Text="↳" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                          <TextBlock Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" VerticalAlignment="Center"/>
                          <Button Grid.Column="2" Classes="icon" Content="✕" Click="RemoveSourceItem_Click" ToolTip.Tip="Rimuove il collegamento. I file restano su disco"/>
                        </Grid></Border>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                      <Button Content="+ Altra cartella" Click="AddSources_Click"/>
                      <Button Content="+ Singoli file" Click="AddFiles_Click"/>
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <Expander Header="Opzioni avanzate" Foreground="{StaticResource MutedBrush}" ToolTip.Tip="Valori di riserva e cambio notte">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="22" Margin="0,10,0,0">
                <Border Classes="card" Padding="20,16"><StackPanel Spacing="9">
                  <TextBlock Text="VALORI DI RISERVA" Classes="eyebrow"/>
                  <TextBlock Text="Usati solo quando header e nome file non dicono il valore." Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                  <Grid ColumnDefinitions="*,100" RowDefinitions="Auto,Auto,Auto" RowSpacing="6"><TextBlock Text="Gain" VerticalAlignment="Center"/><TextBox Grid.Column="1" AutomationProperties.Name="Gain predefinito" Text="{Binding Main.ProjectDefaultGain}"/><TextBlock Grid.Row="1" Text="Offset" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Offset predefinito" Text="{Binding Main.ProjectDefaultOffset}"/><TextBlock Grid.Row="2" Text="Setpoint °C" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" AutomationProperties.Name="Temperatura predefinita" Text="{Binding Main.ProjectDefaultTemperature}"/></Grid>
                  <Button Content="Applica valori e rianalizza" Command="{Binding Main.ApplyProjectDefaultsCommand}" HorizontalAlignment="Left"/>
                </StackPanel></Border>
                <Border Grid.Column="1" Classes="card" Padding="20,16"><StackPanel Spacing="9">
                  <TextBlock Text="NOTTE ASTRONOMICA" Classes="eyebrow"/>
                  <TextBlock Text="{Binding Main.AstronomicalNightExplanation}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                  <Border Classes="note"><TextBlock Text="{Binding Main.AstronomicalNightExample}" FontSize="11" TextWrapping="Wrap"/></Border>
                  <Grid ColumnDefinitions="*,90"><StackPanel><TextBlock Text="La nuova notte inizia alle" FontWeight="SemiBold"/><TextBlock Text="Predefinito: 12:00" Classes="muted" FontSize="10"/></StackPanel><NumericUpDown Grid.Column="1" AutomationProperties.Name="Ora di cambio notte" Minimum="0" Maximum="23" Value="{Binding Main.SessionBoundaryHour}" ToolTip.Tip="I file precedenti a quest’ora appartengono alla notte prima"/></Grid>
                </StackPanel></Border>
              </Grid>
            </Expander>
          </StackPanel>
        </ScrollViewer>

        <!-- 2 · Strumento: is this your gear? Everything detected can be changed. -->
        <Grid x:Name="SetupPage" DataContext="{Binding Observatory}" RowDefinitions="Auto,*" RowSpacing="16">
          <StackPanel Spacing="6">
            <TextBlock Text="PASSO 2 DI 4 · STRUMENTO" Classes="eyebrow accent"/>
            <TextBlock Text="È questo il tuo setup?" Classes="pageTitle"/>
            <TextBlock Text="Camera, ottica e filtri letti da header e nomi file. Tocca una voce per dire cos’è davvero." Classes="serif note" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Grid.Row="1" Classes="card hero" IsVisible="{Binding HasNoInstrument}" MaxWidth="620" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="24"><StackPanel Spacing="12">
            <TextBlock Text="Analizza il progetto per vedere camera, ottica e filtri trovati." Classes="muted" TextWrapping="Wrap"/>
            <Button Content="Analizza" Classes="primary" HorizontalAlignment="Left" Click="Analyze_Click"/>
          </StackPanel></Border>
          <ScrollViewer Grid.Row="1" x:Name="SetupScroll" IsVisible="{Binding HasInstrument}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid ColumnDefinitions="1.35*,*" RowDefinitions="*,Auto" ColumnSpacing="20" RowSpacing="20" Margin="0,0,6,0">
            <Border x:Name="FieldCard" MinHeight="360" Classes="card stack" Padding="0" ClipToBounds="True">
              <Grid RowDefinitions="*,Auto">
                <local:StackPreview Grid.RowSpan="2" Snr="8" Palette="0" Seed="{Binding CameraName}"/>
                <local:SensorFrame Grid.RowSpan="2" WidthDeg="{Binding PreviewWidth}" HeightDeg="{Binding PreviewHeight}" AltWidthDeg="{Binding OtherWidth}" AltHeightDeg="{Binding OtherHeight}" AltLabel="{Binding OtherLabel}" Warn="{Binding HasPending}"/>
                <Border Grid.RowSpan="2" Background="{StaticResource FieldShadeBrush}" IsHitTestVisible="False"/>
                <StackPanel Margin="24,22,24,0" Spacing="6" MaxWidth="290" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding FovEyebrow}" Classes="eyebrow" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding FovBig}" Classes="bignum" FontSize="64"/>
                  <TextBlock Text="{Binding FovSmall}" FontWeight="Light" FontSize="24" Foreground="{StaticResource MutedBrush}"/>
                  <TextBlock Text="{Binding FovNote}" Classes="serif note" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Row="1" Classes="dock">
                  <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="20">
                    <Border Classes="seg" IsVisible="{Binding HasReducerOption}" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="seg" GroupName="optics" IsChecked="{Binding ShowReduced}" Content="{Binding ReducedLabel}"/>
                        <RadioButton Classes="seg" GroupName="optics" IsChecked="{Binding ShowNative}" Content="{Binding NativeLabel}"/>
                      </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding FocalText}" Classes="metric"/><TextBlock Text="{Binding RatioText}" Classes="muted" FontSize="11"/></StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding PreviewScaleText}" Classes="metric"/><TextBlock Text="{Binding SamplingVerdict}" Classes="muted" FontSize="11"/></StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="230" Spacing="3" ClipToBounds="True">
                      <TextBlock Text="{Binding SeeingLabel}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      <local:SamplingGauge Scale="{Binding PreviewScale}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <Border Grid.Row="1" x:Name="TrainCard" Classes="card" Padding="20,16">
              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="TRENO OTTICO" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="tocca una parte per cambiarla" Classes="serif" FontSize="16" Foreground="{StaticResource MutedBrush}"/></Grid>
                <local:OpticalTrain Grid.Row="1" x:Name="TrainView" Telescope="{Binding TrainTelescope}" Reducer="{Binding TrainReducer}" Wheel="{Binding TrainWheel}" Camera="{Binding TrainCamera}" Beam="{Binding BeamColor}"/>
              </Grid>
            </Border>

            <StackPanel Grid.Column="1" Grid.RowSpan="2" Spacing="20" VerticalAlignment="Top">
                <Border x:Name="ProfileCard" Classes="card" Padding="20,18">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="CAMERA E OTTICA" Classes="eyebrow" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Classes="warning" Margin="0" IsVisible="{Binding !IsProfileConfirmed}"><TextBlock Text="{Binding ProfileBadge}"/></Border>
                      <Border Grid.Column="1" Classes="count" Margin="0" IsVisible="{Binding IsProfileConfirmed}"><TextBlock Text="{Binding ProfileBadge}"/></Border>
                    </Grid>
                    <StackPanel Spacing="4" IsVisible="{Binding IsViewing}">
                      <Grid ColumnDefinitions="82,*,Auto,Auto" ColumnSpacing="8" Classes="partRow">
                        <TextBlock Text="Camera" Classes="muted" FontSize="12.5" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding CameraName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DetectedCameraNote}" Classes="muted" FontSize="10.5" TextTrimming="CharacterEllipsis" IsVisible="{Binding CameraWasChanged}"/></StackPanel>
                        <Border Grid.Column="2" Classes="chipOk"><TextBlock Text="{Binding CameraChip}"/></Border>
                        <Button Grid.Column="3" Classes="link" Content="Cambia" Tag="camera" Click="EditProfile_Click" ToolTip.Tip="Di’ quale camera ha scattato davvero"/>
                      </Grid>
                      <Grid ColumnDefinitions="82,*,Auto,Auto" ColumnSpacing="8" Classes="partRow">
                        <TextBlock Text="Ottica" Classes="muted" FontSize="12.5" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding OpticsRow}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Classes="chipOk"><TextBlock Text="{Binding OpticsChip}"/></Border>
                        <Button Grid.Column="3" Classes="link" Content="Cambia" Tag="optics" Click="EditProfile_Click" ToolTip.Tip="Telescopio, focale e apertura"/>
                      </Grid>
                      <Grid ColumnDefinitions="82,*,Auto,Auto" ColumnSpacing="8" Classes="partRow">
                        <TextBlock Text="Riduttore" Classes="muted" FontSize="12.5" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ReducerRow}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Classes="chipOk"><TextBlock Text="{Binding ReducerChip}"/></Border>
                        <Button Grid.Column="3" Classes="link" Content="Cambia" Tag="reducer" Click="EditProfile_Click" ToolTip.Tip="Riduttore o flattener nel treno"/>
                      </Grid>
                      <Grid ColumnDefinitions="82,*,Auto,Auto" ColumnSpacing="8" Classes="partRow">
                        <TextBlock Text="Pixel" Classes="muted" FontSize="12.5" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding PixelRow}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Classes="chipOk"><TextBlock Text="{Binding PixelChip}"/></Border>
                        <Button Grid.Column="3" Classes="link" Content="Cambia" Tag="pixel" Click="EditProfile_Click" ToolTip.Tip="Dimensione del pixel del sensore"/>
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                        <TextBlock Text="Vale per ogni progetto con questa camera." Classes="muted" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Va bene così" Classes="primary" IsVisible="{Binding !IsProfileConfirmed}" Click="ConfirmProfile_Click" ToolTip.Tip="Conferma camera, ottica, riduttore e pixel"/>
                      </Grid>
                    </StackPanel>
                    <StackPanel Spacing="9" IsVisible="{Binding IsEditing}">
                      <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                        <TextBlock Text="Camera" Classes="muted" FontSize="12.5" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="5">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><AutoCompleteBox x:Name="CameraBox" ItemsSource="{Binding CameraChoices}" SelectedItem="{Binding SelectedCamera}" Text="{Binding CameraText}" FilterMode="Contains" MinimumPrefixLength="0" MaxDropDownHeight="260" AutomationProperties.Name="Camera reale"/><Button Grid.Column="1" Classes="icon" Content="▾" Click="BrowseCameras_Click" ToolTip.Tip="Sfoglia il catalogo delle camere"/></Grid>
                          <Border Classes="seg" IsVisible="{Binding IsCustomCamera}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                              <RadioButton Classes="seg" GroupName="cameraType" IsChecked="{Binding CustomCameraMono}" Content="Mono"/>
                              <RadioButton Classes="seg" GroupName="cameraType" IsChecked="{Binding CustomCameraColor}" Content="Colore"/>
                            </StackPanel>
                          </Border>
                          <TextBlock Text="{Binding DetectedCameraNote}" Classes="muted" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Ottica" Classes="muted" FontSize="12.5" VerticalAlignment="Center"/>
                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6"><AutoCompleteBox x:Name="TelescopeBox" ItemsSource="{Binding TelescopeChoices}" SelectedItem="{Binding SelectedTelescope}" Text="{Binding TelescopeText}" FilterMode="Contains" MinimumPrefixLength="0" MaxDropDownHeight="260" AutomationProperties.Name="Ottica"/><Button Grid.Column="1" Classes="icon" Content="▾" Click="BrowseTelescopes_Click" ToolTip.Tip="Sfoglia il catalogo dei telescopi"/></Grid>
                        <TextBlock Grid.Row="2" Text="Focale" Classes="muted" FontSize="12.5" VerticalAlignment="Center" IsVisible="{Binding IsCustomTelescope}"/>
                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsCustomTelescope}">
                          <NumericUpDown Value="{Binding CustomFocal}" Minimum="50" Maximum="10000" Increment="1" FormatString="0 mm" AutomationProperties.Name="Focale nativa"/>
                          <NumericUpDown Grid.Column="1" Value="{Binding CustomAperture}" Minimum="20" Maximum="1000" Increment="1" FormatString="Ø 0 mm" AutomationProperties.Name="Apertura"/>
                        </Grid>
                        <TextBlock Grid.Row="3" Text="Riduttore" Classes="muted" FontSize="12.5" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ReducerBox" ItemsSource="{Binding ReducerChoices}" SelectedItem="{Binding SelectedReducer}" HorizontalAlignment="Stretch" AutomationProperties.Name="Riduttore"/>
                        <TextBlock Grid.Row="4" Text="Pixel" Classes="muted" FontSize="12.5" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="PixelBox" Value="{Binding PixelValue}" Minimum="1" Maximum="30" Increment="0.01" FormatString="0.00 µm" AutomationProperties.Name="Dimensione pixel"/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Ripristina rilevato" IsVisible="{Binding IsProfileConfirmed}" Click="ResetProfile_Click" ToolTip.Tip="Torna a camera, ottica e pixel letti dagli header"/>
                        <Button Content="Annulla" Click="CancelProfile_Click"/>
                        <Button Content="Applica" Classes="primary" Click="ApplyProfile_Click"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border x:Name="WheelCard" Classes="card" Padding="20,18">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding WheelTitle}" Classes="eyebrow" TextWrapping="Wrap" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Classes="warning" Margin="0" IsVisible="{Binding HasPending}"><TextBlock Text="{Binding PendingText}"/></Border>
                      <Border Grid.Column="1" Classes="count" Margin="0" IsVisible="{Binding !HasPending}"><TextBlock Text="{Binding PendingText}"/></Border>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                      <local:FilterWheelView x:Name="WheelView" Slots="{Binding Slots}" SelectedIndex="{Binding SelectedSlot}" Width="170" Height="170" VerticalAlignment="Top"/>
                      <StackPanel Grid.Column="1" DataContext="{Binding SelectedFilter}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RawName}" Classes="mono" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding DisplayName}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <WrapPanel ItemSpacing="6" LineSpacing="6"><Border Classes="count" Margin="0"><TextBlock Text="{Binding Lines}"/></Border><Border Classes="count" Margin="0"><TextBlock Text="{Binding Source}"/></Border></WrapPanel>
                        <local:SpectrumBar Bands="{Binding Bands}"/>
                        <TextBlock Text="{Binding Usage}" Classes="muted" FontSize="11"/>
                      </StackPanel>
                    </Grid>
                    <StackPanel DataContext="{Binding SelectedFilter}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="7">
                      <TextBlock Text="{Binding ChangeHint}" Classes="muted" FontSize="12"/>
                      <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" HorizontalAlignment="Stretch" PlaceholderText="Scegli dal catalogo" MaxDropDownHeight="320" AutomationProperties.Name="Filtro reale"/>
                      <WrapPanel ItemSpacing="8" LineSpacing="6">
                        <Button Content="{Binding ApplyLabel}" Classes="primary" Click="ConfirmFilter_Click" IsEnabled="{Binding Choice, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="Ripristina il riconoscimento" IsVisible="{Binding IsConfirmed}" Click="ForgetFilter_Click" ToolTip.Tip="Torna al filtro riconosciuto dal nome"/>
                      </WrapPanel>
                    </StackPanel>
                    <TextBlock Text="Ciò che scegli resta salvato per questa camera in ogni progetto." Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
                    <ListBox Classes="slots" ItemsSource="{Binding Filters}" SelectedIndex="{Binding SelectedSlot}" AutoScrollToSelectedItem="False">
                      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                      <ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="4" Width="46" ToolTip.Tip="{Binding Usage}"><Ellipse Width="14" Height="14" Fill="{Binding Glass}" HorizontalAlignment="Center"/><TextBlock Text="{Binding RawName}" Classes="mono" FontSize="9.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </StackPanel>
          </Grid></ScrollViewer>
        </Grid>

        <!-- 3 · Calibrazioni: every Light with its Flat, Dark and Bias; the open choices one at a time. -->
        <Grid x:Name="CalibrationPage" RowDefinitions="Auto,*" RowSpacing="16">
          <StackPanel Spacing="6">
            <TextBlock Text="PASSO 3 DI 4 · CALIBRAZIONI" Classes="eyebrow accent"/>
            <TextBlock Text="Ogni Light ha le sue calibrazioni?" Classes="pageTitle"/>
            <TextBlock Text="Flat, Dark e Bias abbinati a ogni posa. Se Forge non può scegliere da solo, ti chiede una cosa alla volta." Classes="serif note" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Grid.Row="1" Classes="card hero" IsVisible="{Binding NeedsAnalysis}" MaxWidth="620" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="24"><StackPanel Spacing="12">
            <TextBlock Text="Analizza il progetto per abbinare Flat, Dark e Bias." Classes="muted" TextWrapping="Wrap"/>
            <Button Content="Analizza" Classes="primary" HorizontalAlignment="Left" Click="Analyze_Click"/>
          </StackPanel></Border>
          <ScrollViewer Grid.Row="1" x:Name="CalibrationScroll" IsVisible="{Binding Analyzed}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid ColumnDefinitions="420,*" ColumnSpacing="20" Margin="0,0,6,0">
            <StackPanel x:Name="OverviewFilters" Spacing="16" VerticalAlignment="Top">
                <Border x:Name="CalibrationCard" Classes="card" Padding="20,18">
                  <Grid ColumnDefinitions="130,*" ColumnSpacing="20">
                    <local:CalibrationRing Width="130" Height="130" Flat="{Binding FlatShare}" Dark="{Binding DarkShare}" Bias="{Binding BiasShare}" Centre="{Binding CalibratedPercent}"/>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="CALIBRAZIONE" Classes="eyebrow"/>
                      <ItemsControl ItemsSource="{Binding CalibrationLines}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9"><Ellipse Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Count}" Classes="mono" FontSize="12"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9" IsVisible="{Binding HasOpenLights}"><Ellipse Width="7" Height="7" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding OpenLabel}" FontSize="12.5"/><TextBlock Grid.Column="2" Text="{Binding OpenLights}" Classes="mono" FontSize="12" Foreground="{StaticResource WarnBrush}"/></Grid>
                    </StackPanel>
                  </Grid>
                </Border>
                <ItemsControl DataContext="{Binding Observatory}" ItemsSource="{Binding FilterCards}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="16"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Classes="card filter" Padding="18,14">
                      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Name}" FontWeight="Light" FontSize="20" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                            <TextBlock Text="{Binding Detail}" Classes="mono muted" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Hours}" Classes="mono" FontSize="16" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding Lights}" Classes="muted" FontSize="11" HorizontalAlignment="Right"/>
                          </StackPanel>
                        </Grid>
                        <local:SpectrumBar Grid.Row="1" Bands="{Binding Bands}" Large="True"/>
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                          <TextBlock Text="{Binding CalibratedDetail}" Classes="muted" FontSize="12"/>
                          <TextBlock Grid.Column="1" Text="{Binding CalibratedText}" FontWeight="SemiBold" FontSize="12"/>
                          <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Classes="goal" Maximum="100" Value="{Binding Calibrated}" Foreground="{Binding Accent}"/>
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

            <StackPanel Grid.Column="1" x:Name="ResolveColumn" Spacing="16" VerticalAlignment="Top">
                <Border x:Name="ResolveCard" Classes="card hero" Padding="22,18">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="DA RISOLVERE" Classes="eyebrow" VerticalAlignment="Center"/><Border Grid.Column="1" Classes="warning" Margin="0" IsVisible="{Binding HasChoice}"><TextBlock Text="{Binding ChoiceBadge}"/></Border></Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasChoice}" ToolTip.Tip="{Binding ChoiceReason}">
                      <TextBlock Text="{Binding ChoiceTitle}" FontSize="20" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding ChoiceSubtitle}" Classes="muted" FontSize="14" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <local:ResolvePaths Grid.Row="2" x:Name="ResolvePathsView" Height="190" IsVisible="{Binding HasChoice}" Source="{Binding ChoiceSource}" Options="{Binding ChoiceOptions}" Accent="{Binding ChoiceAccent}"/>
                    <WrapPanel Grid.Row="3" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding HasChoice}">
                      <Button Content="{Binding UseFirstLabel}" Classes="primary" IsVisible="{Binding HasFirst}" Click="UseFirstCandidate_Click"/>
                      <Button Content="{Binding UseSecondLabel}" IsVisible="{Binding HasSecond}" Click="UseSecondCandidate_Click"/>
                      <Button Content="{Binding ImportLabel}" Classes="primary" IsVisible="{Binding NeedsImport}" Click="ResolveImport_Click"/>
                    </WrapPanel>
                    <StackPanel Grid.Row="1" Grid.RowSpan="3" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding AllCalibrated}" MinHeight="150">
                      <TextBlock Text="Calibrazione completa" FontWeight="Light" FontSize="30"/>
                      <TextBlock Text="{Binding AllCalibratedLabel}" Classes="muted"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="card hero" Padding="18,14">
                  <StackPanel Spacing="8">
                    <TextBlock Text="MAPPA DELLE CALIBRAZIONI" Classes="eyebrow"/>
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:CalibrationMap x:Name="CalibrationMapView"/></ScrollViewer>
                  </StackPanel>
                </Border>
                <Expander x:Name="ReviewExpander" Header="Tutte le scelte aperte, con candidati e ambito" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding HasChoice}">
                  <ListBox x:Name="ReviewList" Margin="0,8,0,0" ItemsSource="{Binding Main.ReviewQueue}" SelectionChanged="ReviewQueue_SelectionChanged" DoubleTapped="ReviewQueue_DoubleTapped"><ListBox.ItemTemplate><DataTemplate><Border Classes="card" Margin="0,0,0,8"><Grid ColumnDefinitions="76,*,150"><TextBlock Text="{Binding Calibration}" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{Binding State}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ExampleFileLabel}" Classes="muted" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/><StackPanel IsVisible="{Binding CanAssignCandidate}" Spacing="7"><ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" DisplayMemberBinding="{Binding Display}" ToolTip.Tip="Scegli la calibrazione da assegnare"/><Expander Header="Dettagli candidati"><DataGrid ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="180"><DataGrid.Columns><DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/><DataGridTextColumn Header="Camera" Binding="{Binding Camera}" Width="*"/><DataGridTextColumn Header="Gain" Binding="{Binding Gain}" Width="70"/><DataGridTextColumn Header="Temp." Binding="{Binding Temperature}" Width="80"/><DataGridTextColumn Header="Esp." Binding="{Binding Exposure}" Width="75"/><DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="65"/></DataGrid.Columns></DataGrid></Expander><WrapPanel><Button Content="{Binding GroupActionLabel}" Classes="primary" Click="AssignLight_Click"/><Button Content="{Binding NightActionLabel}" Click="AssignNight_Click"/><Button Content="{Binding ConfigurationActionLabel}" Click="AssignSession_Click"/></WrapPanel></StackPanel><WrapPanel><Button Content="Modifica metadati" Click="EditReviewMetadata_Click" ToolTip.Tip="Apre il gruppo in Frame e metadati" IsVisible="{Binding CanEditMetadata}"/><Button Content="Aggiungi libreria Master" Click="AddLibrary_Click" IsVisible="{Binding CanAddMasterLibrary}"/><Button Content="Importa Flat" Click="AddSources_Click" IsVisible="{Binding CanImportFlat}"/></WrapPanel></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Scope}" TextWrapping="Wrap" TextAlignment="Right"/><TextBlock Text="{Binding AffectedLabel}" Foreground="{StaticResource AccentBrush}" TextAlignment="Right"/><TextBlock Text="{Binding CandidateLabel}" Classes="muted" TextAlignment="Right"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                </Expander>
              </StackPanel>
          </Grid></ScrollViewer>
        </Grid>

        <!-- 4 · Esporta: the stack you built, where it goes, then PixInsight. -->
        <Grid x:Name="ExportPage" RowDefinitions="Auto,*" RowSpacing="16">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding ExportEyebrow}" Classes="eyebrow accent"/>
            <TextBlock Text="{Binding ExportTitle}" Classes="pageTitle"/>
            <TextBlock Text="{Binding ExportSubtitle}" Classes="serif note" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Grid.Row="1" Classes="card hero" IsVisible="{Binding NeedsAnalysis}" MaxWidth="620" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="24"><StackPanel Spacing="12">
            <TextBlock Text="Analizza il progetto per preparare l’esportazione." Classes="muted" TextWrapping="Wrap"/>
            <Button Content="Analizza" Classes="primary" HorizontalAlignment="Left" Click="Analyze_Click"/>
          </StackPanel></Border>
          <ScrollViewer Grid.Row="1" x:Name="ExportScroll" IsVisible="{Binding Analyzed}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid ColumnDefinitions="1.3*,*" RowDefinitions="*,210" ColumnSpacing="20" RowSpacing="20" Margin="0,0,6,0">
            <Border x:Name="StackCard" MinHeight="430" Classes="card stack" Padding="0" ClipToBounds="True">
              <Grid RowDefinitions="*,Auto">
                <local:StackPreview Grid.RowSpan="2" Snr="{Binding Snr}" Palette="{Binding Palette}" Seed="{Binding Seed}"/>
                <Border Grid.RowSpan="2" Background="{StaticResource StackShadeBrush}" IsHitTestVisible="False"/>
                <Border Classes="seg" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" IsVisible="{Binding CanSho}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="seg" GroupName="palette" IsChecked="{Binding IsHoo}">
                      <StackPanel Orientation="Horizontal" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="{StaticResource HaBrush}"/><Ellipse Width="5" Height="5" Fill="{StaticResource OiiiBrush}"/><Ellipse Width="5" Height="5" Fill="{StaticResource OiiiBrush}"/></StackPanel><TextBlock Text="HOO"/></StackPanel>
                    </RadioButton>
                    <RadioButton Classes="seg" GroupName="palette" IsChecked="{Binding IsSho}">
                      <StackPanel Orientation="Horizontal" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="{StaticResource SiiBrush}"/><Ellipse Width="5" Height="5" Fill="#7CDC6A"/><Ellipse Width="5" Height="5" Fill="#4B8BFF"/></StackPanel><TextBlock Text="SHO"/></StackPanel>
                    </RadioButton>
                  </StackPanel>
                </Border>
                <StackPanel Margin="24,22,24,0" Spacing="6" IsVisible="{Binding HasNights}">
                  <TextBlock Text="{Binding StackEyebrow}" Classes="eyebrow"/>
                  <TextBlock Classes="bignum"><Run Text="{Binding HoursBig}"/><Run Text="{Binding HoursSmall}" Classes="unit"/></TextBlock>
                  <TextBlock Text="{Binding StackNote}" Classes="serif note" MaxWidth="330" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Row="1" Classes="dock" IsVisible="{Binding HasNights}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                    <Button Classes="play" Click="PlayNights_Click" ToolTip.Tip="Riproduci l’accumulo delle notti · Spazio"><Path Data="M7 4 L7 20 L20 12 Z" Fill="{StaticResource FgBrush}" Width="12" Height="12" Stretch="Uniform"/></Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Notti integrate" Classes="muted" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding NightLabel}" Classes="muted" FontSize="12"/></Grid>
                      <Slider x:Name="NightSlider" Classes="nights" Minimum="1" Maximum="{Binding NightCount}" Value="{Binding NightIndex}" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1" AutomationProperties.Name="Notti integrate"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                      <StackPanel><TextBlock Text="{Binding SnrText}" Classes="metric"/><TextBlock Text="SNR vs 1 notte" Classes="muted" FontSize="11"/></StackPanel>
                      <StackPanel><TextBlock Text="{Binding NoiseText}" Classes="metric"/><TextBlock Text="rumore" Classes="muted" FontSize="11"/></StackPanel>
                      <StackPanel><TextBlock Text="{Binding LightsText}" Classes="metric"/><TextBlock Text="Light" Classes="muted" FontSize="11"/></StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <Border Grid.Row="1" x:Name="NightsCard" Classes="card" Padding="20,16">
              <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="NOTTI OSSERVATIVE · 18:00 → 06:00" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="luna e crepuscolo per notte" Classes="serif" FontSize="16" Foreground="{StaticResource MutedBrush}"/></Grid>
                <local:NightSky Grid.Row="1" x:Name="NightSkyView" Nights="{Binding SkyNights}" Shown="{Binding NightIndex}"/>
              </Grid>
            </Border>

            <StackPanel Grid.Column="1" Grid.RowSpan="2" Spacing="20" VerticalAlignment="Top">
                <Border x:Name="ExportCard" Classes="card hero" Padding="22,18">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3"><TextBlock Text="{Binding Main.ExportStateLabel}" Classes="eyebrow accent"/><TextBlock Text="{Binding Main.PlanSummary}" Classes="muted" TextWrapping="Wrap" FontSize="12"/></StackPanel>
                      <TextBlock Grid.Column="1" x:Name="ExportPercentText" Classes="display" FontSize="30" VerticalAlignment="Center"/>
                    </Grid>
                    <local:ExportMap x:Name="ExportMapView"/>
                    <TextBlock Text="{Binding Main.ExportProgressDetail}" TextWrapping="Wrap" FontSize="12.5"/>
                    <UniformGrid Columns="4"><StackPanel Spacing="2"><TextBlock Text="File" Classes="eyebrow"/><TextBlock Text="{Binding Main.ExportFileSummary}" Classes="mono" FontSize="12"/></StackPanel><StackPanel Spacing="2"><TextBlock Text="Da copiare" Classes="eyebrow"/><TextBlock Text="{Binding Main.ExportBytesSummary}" Classes="mono" FontSize="12"/></StackPanel><StackPanel Spacing="2"><TextBlock Text="Spazio" Classes="eyebrow"/><TextBlock Text="{Binding Main.ExportSpaceSummary}" Classes="mono" FontSize="12"/></StackPanel><StackPanel Spacing="2"><TextBlock Text="Tempo stimato" Classes="eyebrow"/><TextBlock Text="{Binding Main.ExportEtaSummary}" Classes="mono" FontSize="12"/></StackPanel></UniformGrid>
                    <Border Classes="rule"/>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                      <TextBox x:Name="ProjectNameBox" Grid.ColumnSpan="2" PlaceholderText="Nome progetto" Text="{Binding Main.ProjectName}"/>
                      <TextBox x:Name="DestinationBox" Grid.Row="1" PlaceholderText="Cartella destinazione" Text="{Binding Main.DestinationPath}"/>
                      <Button Grid.Row="1" Grid.Column="1" Content="Scegli…" Click="ChooseDestination_Click" ToolTip.Tip="Seleziona la cartella di destinazione"/>
                      <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" ColumnSpacing="10"><CheckBox Content="Cartella risultati PixInsight" IsChecked="{Binding Main.CreatePixInsightOutputFolder}" ToolTip.Tip="Usata come Output Directory di WBPP"/><TextBox Grid.Column="1" Text="{Binding Main.PixInsightOutputFolderName}" IsEnabled="{Binding Main.CreatePixInsightOutputFolder}" PlaceholderText="PixInsight Output"/></Grid>
                    </Grid>
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                      <Button Content="Pausa" Click="PauseExport_Click" IsEnabled="{Binding Main.CanPauseExport}" IsVisible="{Binding Main.CanPauseExport}"/>
                      <Button Content="Riprendi" Click="ResumeExport_Click" IsEnabled="{Binding Main.CanResumeExport}" IsVisible="{Binding Main.CanResumeExport}"/>
                      <Button Content="Annulla" Click="CancelExport_Click" IsEnabled="{Binding Main.CanCancelExport}" IsVisible="{Binding Main.CanCancelExport}"/>
                      <Button Content="Controlla prima" Click="ExportPreflight_Click" IsEnabled="{Binding Main.CanRunExportPreflight}" ToolTip.Tip="Verifica spazio, percorsi e conflitti senza copiare nulla"/>
                    </WrapPanel>
                    <Expander Header="Dettagli: controlli, cronologia e tutti i file" Foreground="{StaticResource MutedBrush}">
                      <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Main.ExportChangeSummary}" Classes="muted" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Main.ExportPreflightFindings}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Classes="note" Margin="0,3,6,0"><TextBlock Text="{Binding Title}" ToolTip.Tip="{Binding Detail}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="Cronologia dati" Classes="eyebrow"/>
                        <ItemsControl ItemsSource="{Binding Main.ExportHistory}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="note" Margin="0,0,0,6"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Date}" Classes="muted"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Button Content="Genera anteprima dei file" Click="BuildPlan_Click" HorizontalAlignment="Left" ToolTip.Tip="Calcola cartelle e nomi senza copiare file"/>
                        <Border Classes="card" Padding="10" MaxHeight="320"><TreeView ItemsSource="{Binding Main.PlannedTreeRoots}"><TreeView.ItemTemplate><TreeDataTemplate ItemsSource="{Binding Children}"><Grid ColumnDefinitions="Auto,*,Auto" Margin="3"><TextBlock Text="{Binding Icon}" Foreground="{StaticResource AccentBrush}" Margin="4"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10"/></StackPanel><Border Grid.Column="2" Classes="count"><TextBlock Text="{Binding Count}"/></Border></Grid></TreeDataTemplate></TreeView.ItemTemplate></TreeView></Border>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Border>

                <Border x:Name="WbppCard" Classes="card" Padding="22,18">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="PIXINSIGHT WBPP" Classes="eyebrow accent"/><TextBlock Text="Un master integrato per filtro" Classes="stepTitle"/></StackPanel><Button Grid.Column="1" VerticalAlignment="Center" Content="Apri in PixInsight" Click="OpenWbppInstance_Click" Classes="primary" ToolTip.Tip="Genera l’istanza XPSM e la apre in PixInsight: WBPP resta fermo finché non premi Run"/></Grid>
                    <local:PipelineFlow x:Name="PipelineFlowView"/>
                    <Border Classes="warningBanner"><TextBlock Text="Prima di premere Run in WBPP, apri Calibration e controlla Flat, Dark e Bias di ogni gruppo Light." TextWrapping="Wrap"/></Border>
                    <Expander Header="Grouping Keywords da inserire a mano" Foreground="{StaticResource MutedBrush}">
                      <StackPanel Spacing="8" Margin="0,8,0,0">
                        <Border Classes="note"><TextBlock Text="Grouping Keywords: una riga per keyword, Pre ON, Post OFF." TextWrapping="Wrap"/></Border>
                        <Grid ColumnDefinitions="130,70,70,*" Margin="14,5,14,0"><TextBlock Text="KEYWORD" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="PRE" Classes="eyebrow"/><TextBlock Grid.Column="2" Text="POST" Classes="eyebrow"/><TextBlock Grid.Column="3" Text="FUNZIONE" Classes="eyebrow"/></Grid>
                        <ItemsControl ItemsSource="{Binding Main.WbppKeywords}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="card" Margin="0,0,0,7" Padding="14,10"><Grid ColumnDefinitions="130,70,70,*"><TextBlock Text="{Binding Keyword}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Pre}"/><TextBlock Grid.Column="2" Text="{Binding Post}"/><TextBlock Grid.Column="3" Text="{Binding Reason}" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <ItemsControl ItemsSource="{Binding Main.WbppNotes}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="note" Margin="0,0,0,6"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Border>
              </StackPanel>
          </Grid></ScrollViewer>
        </Grid>
      </Carousel>
    </Grid>

    <!-- Footer: back, what this step asks, and the one button that moves on. -->
    <Grid Grid.Row="3" x:Name="Footer" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18" MinHeight="56">
      <Button x:Name="BackButton" Classes="ghost" Content="← Indietro" Click="Back_Click" IsVisible="{Binding CanGoBack}" VerticalAlignment="Center" MinWidth="110"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="4,0">
        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding StepHint}" Classes="muted" FontSize="13" TextWrapping="Wrap" MaxWidth="820" VerticalAlignment="Center"/>
      </StackPanel>
      <Button Grid.Column="2" x:Name="NextButton" Classes="next" Click="Next_Click" IsEnabled="{Binding NextEnabled}" MinWidth="240" ToolTip.Tip="Il passo successivo · Invio">
        <Panel>
          <Border x:Name="NextFill" Classes="nextFill" HorizontalAlignment="Left" Width="0"/>
          <TextBlock Text="{Binding NextLabel}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Panel>
      </Button>
    </Grid>
  </Grid>

  <!-- Tools: statistics, quality, frame metadata and the Master Library open over the steps. The steps themselves never hide in here. -->
  <Border x:Name="SheetHost" IsVisible="False" Background="{StaticResource SheetScrimBrush}" PointerPressed="SheetScrim_PointerPressed">
    <Border x:Name="Drawer" Classes="drawer" Margin="40,18,18,18" PointerPressed="Drawer_PointerPressed">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="24,16,16,6">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock x:Name="SheetEyebrow" Classes="eyebrow accent"/>
          </StackPanel>
          <Button Grid.Column="1" Classes="close" Content="✕" Click="CloseSheet_Click" ToolTip.Tip="Chiudi · Esc"/>
        </Grid>
        <TabControl Grid.Row="1" x:Name="SheetTabs" Classes="sheets" Margin="24,0,24,20" SelectionChanged="SheetTabs_SelectionChanged">
          <TabItem x:Name="ProjectTab" Header="Metadati">
            <Grid Margin="0,4,0,0" RowDefinitions="Auto,*" RowSpacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel><TextBlock Text="Frame e metadati" Classes="title"/><TextBlock Text="{Binding ProjectDocumentStatus}" Classes="muted"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Content="Nuovo" ToolTip.Tip="Crea un nuovo progetto · Ctrl+N" Click="NewProject_Click"/>
                  <Button Content="Apri" ToolTip.Tip="Apri progetto · Ctrl+O" Click="OpenProject_Click"/>
                  <Button Content="Salva" ToolTip.Tip="Salva progetto · Ctrl+S · Salva con nome Ctrl+Shift+S" Click="SaveProject_Click"/>
                  <Button x:Name="AnalyzeButton" Content="{Binding AnalysisActionLabel}" ToolTip.Tip="Analizza progetto · Ctrl+Invio" Classes="primary" Click="Analyze_Click" IsEnabled="{Binding CanAnalyzeProject}"/>
                </StackPanel>
              </Grid>
            <Grid x:Name="AnalysisGrid" Grid.Row="1" ColumnDefinitions="*,0,0">
              <Border Classes="card" Padding="10"><Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox PlaceholderText="Cerca file, filtro, sessione…" Text="{Binding SearchText}"/><CheckBox Grid.Column="1" Content="Solo da rivedere" IsChecked="{Binding ShowIssuesOnly}" VerticalAlignment="Center"/><Button Grid.Column="2" Content="Pulisci filtri" Click="ClearAnalysisFilters_Click"/></Grid>
                <TreeView Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding TreeRoots}" SelectedItem="{Binding SelectedNode}" DoubleTapped="Tree_DoubleTapped">
                  <TreeView.ItemTemplate><TreeDataTemplate ItemsSource="{Binding Children}"><Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="2,3"><CheckBox IsVisible="{Binding CanBeMarked}" IsChecked="{Binding IsMarked}" Click="TreeMark_Click"/><TextBlock Grid.Column="1" Text="{Binding Icon}" Foreground="{StaticResource AccentBrush}" Margin="6,0"/><TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold"/><Border Grid.Column="3" Classes="count"><TextBlock Text="{Binding Count}"/></Border><Border Grid.Column="4" Classes="warning" IsVisible="{Binding HasIssues}"><TextBlock Text="{Binding IssueCount}"/></Border></Grid></TreeDataTemplate></TreeView.ItemTemplate>
                </TreeView>
              </Grid></Border>
              <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" IsVisible="{Binding HasSelection}"/>
              <Border Grid.Column="2" Classes="card" Padding="16" IsVisible="{Binding HasSelection}" Margin="8,0,0,0"><ScrollViewer><StackPanel Spacing="10">
                <TextBlock Text="Inspector" Classes="eyebrow"/><TextBlock Text="{Binding SelectionTitle}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectionDetail}" Classes="muted"/>
                <TextBlock Text="Tipo frame" Classes="label"/><ComboBox ItemsSource="{Binding FrameKinds}" SelectedItem="{Binding EditKind}"/>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="7"><TextBlock Text="Gain"/><TextBlock Grid.Column="1" Text="{Binding GainSource}" Classes="source"/><TextBox Grid.Row="1" Grid.ColumnSpan="2" AutomationProperties.Name="Gain selezione" Text="{Binding EditGain}"/><TextBlock Grid.Row="2" Text="Offset"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OffsetSource}" Classes="source"/><TextBox Grid.Row="3" Grid.ColumnSpan="2" AutomationProperties.Name="Offset selezione" Text="{Binding EditOffset}"/><TextBlock Grid.Row="4" Text="Temperatura (°C)"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TemperatureSource}" Classes="source"/><TextBox Grid.Row="5" Grid.ColumnSpan="2" AutomationProperties.Name="Temperatura selezione" Text="{Binding EditTemperature}"/></Grid>
                <TextBlock Text="Filtro" Classes="label"/><TextBox AutomationProperties.Name="Filtro selezione" Text="{Binding EditFilter}"/>
                <TextBlock Text="Flat Set" Classes="label"/><TextBox AutomationProperties.Name="Flat Set selezione" Text="{Binding EditFlatSet}" ToolTip.Tip="Flat Set assegnato alla sessione"/>
                <TextBlock Text="Sessione astronomica" Classes="label"/><TextBox AutomationProperties.Name="Sessione astronomica selezione" Text="{Binding EditSession}"/>
                <Button Content="{Binding ApplyLabel}" Classes="primary" Command="{Binding ApplyOverridesCommand}"/>
                <Border Classes="rule"/>
                <Expander Header="Collegamento Flat avanzato" ToolTip.Tip="Collegamento manuale di una selezione"><StackPanel Spacing="7"><TextBlock Text="{Binding ManualLinkSelectionText}" Classes="muted" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding AvailableFlatSets}" SelectedItem="{Binding SelectedFlatSet}" ToolTip.Tip="Flat Set da assegnare alla selezione"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Content="Collega" Command="{Binding LinkFlatSetCommand}" ToolTip.Tip="Assegna il Flat Set alla selezione"/><Button Grid.Column="1" Content="Rimuovi collegamento" Command="{Binding UnlinkFlatSetCommand}" ToolTip.Tip="Ripristina l’assegnazione automatica"/></Grid></StackPanel></Expander>
                <Expander Header="Header effettivi"><TextBox AutomationProperties.Name="Header effettivi" Text="{Binding RawHeaders}" IsReadOnly="True" AcceptsReturn="True" MinHeight="160" FontFamily="{StaticResource MonoFont}"/></Expander>
              </StackPanel></ScrollViewer></Border>
            </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Statistiche"><ScrollViewer><StackPanel Margin="0,4,0,0" Spacing="12">
            <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Statistiche" Classes="title"/><TextBlock Text="{Binding StatisticsSummary}" Classes="muted" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" VerticalAlignment="Center" Content="Esporta dati CSV + JSON" Click="ExportStatistics_Click"/></Grid>
              <Border x:Name="StatsNights" Classes="card" Padding="18"><StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="NOTTI DI ACQUISIZIONE" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="ore per notte · linea: integrazione cumulata" Classes="muted" FontSize="10"/></Grid>
                <local:NightsTimeline Nights="{Binding Nights}"/>
              </StackPanel></Border>
            <TextBlock Text="Sessioni di configurazione" Classes="eyebrow"/>
            <ItemsControl ItemsSource="{Binding SessionStatistics}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="card" Margin="0,0,0,8" Padding="14"><Grid ColumnDefinitions="120,*,150,120,Auto"><TextBlock Text="{Binding Filter}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Session}"/><TextBlock Text="{Binding TechnicalId}" Classes="mono muted" FontSize="10"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Integration}" Classes="mono"/><TextBlock Grid.Column="3" Text="{Binding NightsLabel}"/><TextBlock Grid.Column="4" Text="{Binding Status}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></ScrollViewer></TabItem>
          <TabItem Header="Qualità"><Grid Margin="0,4,0,0" RowDefinitions="Auto,Auto,210,*" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel><TextBlock Text="Qualità" Classes="title"/><TextBlock Text="FWHM, SNR, eccentricità e rumore per serie." Classes="muted" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button Content="Analizza tutte" ToolTip.Tip="Analizza tutte le serie una alla volta" Classes="primary" Click="AnalyzeAllQuality_Click" IsEnabled="{Binding CanRunAllQualityAnalysis}"/><Button Content="Serie selezionata" ToolTip.Tip="Misura i Light della serie selezionata" Click="AnalyzeQuality_Click" IsEnabled="{Binding CanRunQualityAnalysis}"/><Button Content="Annulla" Click="CancelQuality_Click" IsEnabled="{Binding IsQualityAnalyzing}"/></StackPanel></Grid>
            <Border Grid.Row="1" Classes="card" Padding="14,10"><Grid ColumnDefinitions="300,*,Auto" ColumnSpacing="18"><StackPanel Spacing="4"><TextBlock Text="Serie" Classes="eyebrow"/><ComboBox AutomationProperties.Name="Serie di calibrazione" ItemsSource="{Binding QualitySeries}" SelectedItem="{Binding SelectedQualitySeries}" DisplayMemberBinding="{Binding Display}" SelectionChanged="QualitySeries_SelectionChanged"/><TextBlock Text="Confronta soltanto frame della stessa serie, esposizione e configurazione." Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Spacing="2"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Soglia anomalie" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="{Binding QualitySigmaThreshold, StringFormat='σ {0:0.0}'}" Classes="mono" Foreground="{StaticResource WarnBrush}"/></Grid><Slider AutomationProperties.Name="Soglia anomalie" Minimum="2" Maximum="6" Value="{Binding QualitySigmaThreshold}" TickFrequency="0.1" PropertyChanged="QualityThreshold_Changed"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding QualityTableSummary}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><CheckBox Grid.Column="1" Content="Solo sospetti" IsChecked="{Binding QualityShowOnlySuspects}"/></Grid></StackPanel><StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center"><Button Content="Escludi sospetti" Click="ExcludeQualitySuspects_Click" ToolTip.Tip="Sposta i file segnalati in Excluded/Quality" IsEnabled="{Binding CanExcludeQualitySuspects}"/><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="Escludi selezione" Click="ExcludeSelectedQuality_Click" IsEnabled="{Binding CanExcludeSelectedQuality}"/><Button Content="Ripristina" Click="RestoreQuality_Click"/></StackPanel></StackPanel></Grid></Border>
            <Grid Grid.Row="2" ColumnDefinitions="1.35*,1*" ColumnSpacing="10"><Border Classes="chartCard" Padding="10,8"><local:QualitySky x:Name="QualitySkyView" Items="{Binding QualityChartFrames}" Threshold="{Binding QualitySigmaThreshold}" SelectedItem="{Binding SelectedQualityFrame}"/></Border><Border Grid.Column="1" Classes="chartCard"><local:QualityDistributionChart x:Name="QualityChart" Items="{Binding QualityChartFrames}" Threshold="{Binding QualitySigmaThreshold}" SelectedItem="{Binding SelectedQualityFrame}" PointerPressed="QualityChart_PointerPressed"/></Border></Grid>
            <Grid Grid.Row="3" ColumnDefinitions="1*,1.3*" ColumnSpacing="10"><DataGrid x:Name="QualityGrid" ItemsSource="{Binding QualityFrames}" SelectedItem="{Binding SelectedQualityFrame}" SelectionMode="Extended" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="QualityGrid_SelectionChanged" DoubleTapped="QualityGrid_DoubleTapped"><DataGrid.Columns><DataGridTextColumn Header="Stato" Binding="{Binding State}" SortMemberPath="State" Width="90"/><DataGridTextColumn Header="File" Binding="{Binding FileName}" SortMemberPath="FileName" Width="*"/><DataGridTextColumn Header="FWHM" Binding="{Binding FwhmText}" SortMemberPath="Fwhm" Width="70"/><DataGridTextColumn Header="Ecc." Binding="{Binding EccentricityText}" SortMemberPath="Eccentricity" Width="70"/><DataGridTextColumn Header="Rumore" Binding="{Binding NoiseText}" SortMemberPath="Noise" Width="75"/><DataGridTextColumn Header="SNR" Binding="{Binding SnrText}" SortMemberPath="Snr" Width="65"/><DataGridTextColumn Header="Stelle" Binding="{Binding StarsText}" SortMemberPath="StarCount" Width="70"/><DataGridTextColumn Header="Zone" Binding="{Binding CoverageText}" SortMemberPath="CoverageZones" Width="62"/><DataGridTextColumn Header="Score" Binding="{Binding OutlierScore}" SortMemberPath="OutlierScore" Width="70"/></DataGrid.Columns></DataGrid>
              <Border Grid.Column="1" Classes="preview"><Grid RowDefinitions="Auto,Auto,*"><Grid RowDefinitions="Auto,Auto" RowSpacing="6"><StackPanel><TextBlock Text="BLINK / ISPEZIONE" Classes="eyebrow"/><TextBlock Text="{Binding SelectedQualityFrame.FileName}" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5"><Button x:Name="BlinkButton" Content="Avvia Blink" Click="Blink_Click"/><Button Content="Escludi / ripristina" Click="ToggleQualityExclusion_Click"/><Button Content="Dettaglio HD" Click="QualityFullResolution_Click"/><Button Content="−" ToolTip.Tip="Riduci anteprima" Click="ZoomOut_Click"/><Button Content="Adatta" Click="ZoomFit_Click"/><Button Content="+" ToolTip.Tip="Ingrandisci anteprima" Click="ZoomIn_Click"/></StackPanel></Grid><Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="0,6"><CheckBox Content="Debayer temporaneo" IsChecked="{Binding QualityDebayerPreview}" Click="QualityPreviewOptions_Click"/><TextBlock Grid.Column="1" Text="Stretch" Classes="muted" Margin="14,0,6,0"/><Slider Grid.Column="2" AutomationProperties.Name="Intensità stretch" Minimum="0" Maximum="12" Value="{Binding QualityStretchStrength}" PropertyChanged="QualityStretch_Changed"/></Grid><ScrollViewer Grid.Row="2" x:Name="QualityPreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Image x:Name="QualityPreviewImage" Source="{Binding SelectedQualityFrame.Preview}" Stretch="None" RenderTransformOrigin="0,0"><Image.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Image.RenderTransform></Image></ScrollViewer></Grid></Border></Grid>
          </Grid></TabItem>
          <TabItem Header="Libreria Master"><Grid Margin="0,4,0,0" RowDefinitions="Auto,Auto,*" RowSpacing="10"><Border Classes="card"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><StackPanel><TextBlock Text="Libreria Master" Classes="title"/><TextBlock Text="Verifica e organizzazione dei Master. Non richiede un progetto." Classes="muted"/></StackPanel><Button Grid.Column="1" Content="Scansiona" Click="ScanMasterLibraries_Click" ToolTip.Tip="Legge i metadati in sola lettura"/><Button Grid.Column="2" Content="Verifica" Click="PreviewMasterOrganizer_Click" ToolTip.Tip="Controlla metadati e destinazioni prima della copia"/><Button Grid.Column="3" Content="Annulla ultimo batch" Click="RollbackMasterOrganizer_Click" ToolTip.Tip="Rimuove le copie dell’ultima operazione"/></Grid></Border><Border Grid.Row="1" Classes="card hero" Padding="18,14"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="COPERTURA DARK" Classes="eyebrow"/><TextBlock Text="Esposizione × temperatura del sensore, per gain e offset." Classes="muted" TextWrapping="Wrap"/></StackPanel><TextBlock x:Name="DarkCoverageSummary" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></Grid><ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:DarkCoverageMap x:Name="DarkCoverageView"/></ScrollViewer></StackPanel></Border><Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox Text="{Binding MasterOrganizerDestination}" PlaceholderText="Destinazione nuova libreria"/><Button Grid.Column="1" Content="Scegli destinazione" Click="ChooseMasterOrganizerDestination_Click"/><Button Grid.Column="2" Content="Copia, imprimi e organizza" Classes="primary" Click="OrganizeMasterLibrary_Click"/></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding MasterOrganizerItems}" AutoGenerateColumns="False" DoubleTapped="MasterOrganizer_DoubleTapped"><DataGrid.Columns><DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" MinWidth="200"/><DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="80"/><DataGridTextColumn Header="Camera" Binding="{Binding Camera, Mode=TwoWay}" Width="140"/><DataGridTextColumn Header="Gain" Binding="{Binding Gain, Mode=TwoWay}" Width="80"/><DataGridTextColumn Header="Offset" Binding="{Binding Offset, Mode=TwoWay}" Width="80"/><DataGridTextColumn Header="Temperatura" Binding="{Binding Temperature, Mode=TwoWay}" Width="100"/><DataGridTextColumn Header="Esposizione" Binding="{Binding Exposure, Mode=TwoWay}" Width="100"/><DataGridTextColumn Header="Readout" Binding="{Binding ReadoutMode, Mode=TwoWay}" Width="110"/><DataGridTextColumn Header="Destinazione" Binding="{Binding SuggestedPath}" Width="2*" MinWidth="260"/><DataGridTextColumn Header="Stato" Binding="{Binding State}" Width="150"/></DataGrid.Columns></DataGrid></Grid></Grid></TabItem>
          <TabItem x:Name="DiagnosticsTab" Header="Log"><Grid Margin="0,4,0,0" RowDefinitions="Auto,*" RowSpacing="10"><Border Classes="card"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel><TextBlock Text="Diagnostica" Classes="title"/><TextBlock Text="{Binding DiagnosticsSummary}" Classes="muted"/><TextBlock Text="I log escludono immagini, coordinate e percorsi completi." Classes="muted"/></StackPanel><Button Grid.Column="1" Content="Aggiorna" Click="RefreshDiagnostics_Click"/><Button Grid.Column="2" Content="Esporta ZIP di supporto" Click="ExportSupport_Click"/></Grid></Border><DataGrid Grid.Row="1" ItemsSource="{Binding DiagnosticEvents}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Ora" Binding="{Binding Timestamp}" Width="150"/><DataGridTextColumn Header="Livello" Binding="{Binding Level}" Width="80"/><DataGridTextColumn Header="Codice" Binding="{Binding Code}" Width="150"/><DataGridTextColumn Header="Operazione" Binding="{Binding Operation}" Width="180"/><DataGridTextColumn Header="ID" Binding="{Binding Correlation}" Width="90"/><DataGridTextColumn Header="Messaggio" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
        </TabControl>
      </Grid>
    </Border>
  </Border>

  <!-- Ctrl K -->
  <Border x:Name="PaletteHost" IsVisible="False" Background="{StaticResource SheetScrimBrush}" PointerPressed="PaletteScrim_PointerPressed">
    <Border Classes="palette" Width="560" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,110,0,0" PointerPressed="Drawer_PointerPressed">
      <StackPanel Spacing="8">
        <TextBox x:Name="PaletteQuery" Classes="palette" Text="{Binding Query}" PlaceholderText="Cerca un comando" KeyDown="PaletteQuery_KeyDown"/>
        <ListBox x:Name="PaletteList" Classes="palette" ItemsSource="{Binding Commands}" SelectedIndex="{Binding CommandIndex}" MaxHeight="380" Tapped="PaletteList_Tapped">
          <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Title}" FontSize="13.5"/><TextBlock Grid.Column="1" Text="{Binding Hint}" Classes="kbd"/></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>
  </Border>

    <Border x:Name="SettingsPanel" IsVisible="False" HorizontalAlignment="Right" Width="410" Classes="sheet" Padding="20" ZIndex="20">
      <ScrollViewer><StackPanel Spacing="11">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Menu" Classes="title"/><Button Grid.Column="1" Content="✕" Click="ToggleSettings_Click"/></Grid>
        <TextBlock Text="Preferenze" Classes="eyebrow"/>
        <TextBlock Text="Lingua"/>
        <ComboBox ItemsSource="{Binding UiLanguages}" SelectedItem="{Binding UiLanguage}"/>
        <TextBlock Text="Dimensione interfaccia"/>
        <ComboBox x:Name="DensitySelector" AutomationProperties.Name="Densità interfaccia" SelectionChanged="DensitySelector_SelectionChanged"><ComboBoxItem Tag="Comoda" Content="Comoda"/><ComboBoxItem Tag="Compatta" Content="Compatta"/><ComboBoxItem Tag="Ampia" Content="Ampia"/></ComboBox>
        <CheckBox Content="Riduci animazioni" ToolTip.Tip="Disattiva le animazioni non essenziali" IsChecked="{Binding ReducedMotion}" Click="UiPreferenceChanged_Click"/>
        <Border Classes="rule" Margin="0,5"/>
        <TextBlock Text="Progetto" Classes="eyebrow"/>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="7"><Button Content="Nuovo progetto" Click="NewProject_Click"/><Button Grid.Column="1" Content="Salva con nome" Click="SaveProjectAs_Click"/></Grid>
        <Border Classes="rule" Margin="0,5"/>
        <TextBlock Text="Aiuto" Classes="eyebrow"/>
        <Button Content="Configurazione iniziale" ToolTip.Tip="Librerie, immagini e prima analisi" Click="OpenOnboarding_Click"/>
        <Button Content="Tour guidato" ToolTip.Tip="Panoramica delle schermate · F1" Click="StartTour_Click"/>
        <Button Content="Apri il progetto demo" ToolTip.Tip="Progetto di esempio con FITS sintetici" Click="OpenDemo_Click"/>
        <Button Content="Guida rapida" Click="OpenGuide_Click"/>
        <Button Content="Segnala un problema" Click="ReportIssue_Click"/>
        <Button Content="GitHub" Click="OpenRepository_Click"/>
        <Button Content="Diagnostica e file di supporto" Click="OpenDiagnosticsTab_Click"/>
        <Border Classes="note"><StackPanel Spacing="7"><TextBlock Text="AstroProject Forge" FontWeight="SemiBold"/><TextBlock Text="{Binding VersionDisplay}" Classes="muted"/><TextBlock x:Name="UpdateStatus" Classes="muted" TextWrapping="Wrap"/><ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="4"/><Button x:Name="UpdateButton" Content="Controlla aggiornamenti" Click="InstallUpdate_Click"/><TextBlock Text="Gianmarco Spagnoli (@astropuzzo)" TextWrapping="Wrap"/><TextBlock Text="Copyright © 2026 Gianmarco Spagnoli" Classes="muted"/></StackPanel></Border>
        <Expander Header="Opzioni avanzate"><StackPanel Spacing="9" Margin="0,9,0,0"><TextBlock Text="Margine spazio esportazione (%)"/><NumericUpDown Value="{Binding ExportMarginPercent}" Minimum="0" Maximum="100"/><TextBlock Text="Riserva minima (GiB)"/><NumericUpDown Value="{Binding ExportMinimumReserveGiB}" Minimum="0" Maximum="1000"/><Button Content="Rileggi i metadati" ToolTip.Tip="Forza una nuova lettura alla prossima analisi" Click="ClearCache_Click"/></StackPanel></Expander>
      </StackPanel></ScrollViewer>
    </Border>
    <Border IsVisible="{Binding ShowOnboarding}" Background="{StaticResource ScrimBrush}" ZIndex="40">
      <Border Classes="card" Width="760" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
        <Grid RowDefinitions="7,*,74">
          <Border Background="{StaticResource SpectrumBrush}" CornerRadius="18,18,0,0"/>
          <Grid Grid.Row="1" Margin="34,28,34,18">
            <StackPanel x:Name="OnboardingStep1" Spacing="14">
              <TextBlock Text="WELCOME · BENVENUTO" Classes="eyebrow"/>
              <TextBlock Text="Lingua" FontSize="34" FontWeight="SemiBold"/>
              <TextBlock Text="Modificabile in seguito dal Menu." Classes="muted" FontSize="14" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="9" Margin="0,15,0,0"><Button Content="English" Classes="primary" Click="OnboardingEnglish_Click" Padding="22,18" FontSize="18"/><Button Grid.Column="1" Content="Italiano" Click="OnboardingItalian_Click" Padding="22,18" FontSize="18"/></Grid>
              <Border Classes="note" Margin="0,8,0,0"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Lingua selezionata" Classes="muted"/><TextBlock Text="{Binding UiLanguage}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></StackPanel></Border>
            </StackPanel>
            <StackPanel x:Name="OnboardingStep2" IsVisible="False" Spacing="14">
              <TextBlock Text="COME FUNZIONA" Classes="eyebrow"/>
              <TextBlock Text="Quattro passi, sempre in ordine" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="Un solo pulsante in basso a destra ti porta al passo successivo. Gli originali non vengono mai modificati." Classes="muted" FontSize="14" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="9" Margin="0,12,0,0">
                <Border Classes="note"><StackPanel Spacing="5"><TextBlock Text="01" Classes="eyebrow"/><TextBlock Text="Importa" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Master Library e acquisizioni" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Grid.Column="1" Classes="note"><StackPanel Spacing="5"><TextBlock Text="02" Classes="eyebrow"/><TextBlock Text="Strumento" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Camera, ottica e filtri: correggi ciò che non è giusto" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Grid.Column="2" Classes="note"><StackPanel Spacing="5"><TextBlock Text="03" Classes="eyebrow"/><TextBlock Text="Calibrazioni" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Flat, Dark e Bias per ogni posa" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Grid.Column="3" Classes="note"><StackPanel Spacing="5"><TextBlock Text="04" Classes="eyebrow"/><TextBlock Text="Esporta" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Cartella pronta e istanza WBPP" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
              </Grid>
              <Border Classes="note" Margin="0,6,0,0"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="3"><TextBlock Text="Progetto demo" FontWeight="SemiBold"/><TextBlock Text="Due notti di FITS sintetici (ASIAIR, N.I.N.A.) con Flat e Master, seguite dal tour guidato." Classes="muted" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Apri demo" VerticalAlignment="Center" Click="OpenDemo_Click"/></Grid></Border>
            </StackPanel>
          </Grid>
          <Border Grid.Row="2" Background="#660E162C" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,18,18"><Grid ColumnDefinitions="*,Auto,Auto" Margin="24,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock x:Name="OnboardingProgress" Text="1 / 2" Classes="eyebrow"/><Button Content="Salta" Click="OnboardingSkip_Click"/></StackPanel><Button x:Name="OnboardingBackButton" Grid.Column="1" Content="Indietro" IsVisible="False" Click="OnboardingBack_Click" Margin="0,0,8,0"/><Button x:Name="OnboardingNextButton" Grid.Column="2" Content="Continua" Classes="primary" Click="OnboardingNext_Click" MinWidth="140"/></Grid></Border>
        </Grid>
      </Border>
    </Border>

  <Border x:Name="Toast" Classes="toast" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,96">
    <StackPanel Orientation="Horizontal" Spacing="10"><Ellipse Width="7" Height="7" Fill="{StaticResource OkBrush}" VerticalAlignment="Center"/><TextBlock x:Name="ToastText" MaxWidth="620" TextTrimming="CharacterEllipsis"/></StackPanel>
  </Border>
  <local:GuidedTour x:Name="Tour"/>
  <local:FirstLightOverlay x:Name="FirstLight" IsVisible="False"/>
  </Panel>
</Window>
