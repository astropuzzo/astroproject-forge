<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AstroForge.CrossPlatform.Controls">
  <!--
    "Cielo profondo" design system. Colours come from the night sky and from the emission lines
    the app sorts all day: Hα red, OIII teal, SII amber. Every surface is dark glass over the
    live starfield, so cards stay translucent and borders stay faint.
  -->
  <Styles.Resources>
    <Color x:Key="VoidColor">#04060D</Color>
    <Color x:Key="InkColor">#070B18</Color>
    <Color x:Key="FgColor">#EEF1FF</Color>
    <Color x:Key="MutedColor">#8E97BD</Color>
    <Color x:Key="DimColor">#5B6490</Color>
    <Color x:Key="AccentColor">#9DB8FF</Color>
    <Color x:Key="HaColor">#FF5D73</Color>
    <Color x:Key="OiiiColor">#3FE0D0</Color>
    <Color x:Key="SiiColor">#FFAE5C</Color>
    <Color x:Key="OkColor">#7CF2C9</Color>
    <Color x:Key="WarnColor">#FFC27A</Color>

    <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource VoidColor}"/>
    <SolidColorBrush x:Key="FgBrush" Color="{StaticResource FgColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="DimBrush" Color="{StaticResource DimColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="HaBrush" Color="{StaticResource HaColor}"/>
    <SolidColorBrush x:Key="OiiiBrush" Color="{StaticResource OiiiColor}"/>
    <SolidColorBrush x:Key="SiiBrush" Color="{StaticResource SiiColor}"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="#2196AAFF"/>
    <SolidColorBrush x:Key="LineHiBrush" Color="#52AABEFF"/>
    <SolidColorBrush x:Key="GlassBrush" Color="#850E162C"/>
    <SolidColorBrush x:Key="GlassSolidBrush" Color="#F20B1122"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#B3060A18"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#D904060D"/>
    <SolidColorBrush x:Key="IconTileBrush" Color="#269DB8FF"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#179DB8FF"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#8C070B18"/>

    <LinearGradientBrush x:Key="CardBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#9E1C264A" Offset="0"/>
      <GradientStop Color="#850E162C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroCardBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#B3243466" Offset="0"/>
      <GradientStop Color="#8C0E1A36" Offset="0.55"/>
      <GradientStop Color="#8C0A2A33" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#F4F6FF" Offset="0"/>
      <GradientStop Color="#C4D3FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryHoverBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#FFFFFF" Offset="0"/>
      <GradientStop Color="#D6E1FF" Offset="1"/>
    </LinearGradientBrush>
    <!-- The spectrum ribbon: OIII 500.7 → Hα 656.3 → SII 671.6, used for brand accents. -->
    <LinearGradientBrush x:Key="SpectrumBrush" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Color="#3FE0D0" Offset="0"/>
      <GradientStop Color="#9DB8FF" Offset="0.45"/>
      <GradientStop Color="#FF5D73" Offset="0.85"/>
      <GradientStop Color="#FFAE5C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HealthBrush" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Color="#A6123040" Offset="0"/>
      <GradientStop Color="#850E162C" Offset="0.6"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WarnCardBrush" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Color="#A63A2710" Offset="0"/>
      <GradientStop Color="#850E162C" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="DisplayFont">avares://AstroProjectForge/Assets/Fonts#Unbounded</FontFamily>
    <FontFamily x:Key="MonoFont">avares://AstroProjectForge/Assets/Fonts#JetBrains Mono</FontFamily>
    <FontFamily x:Key="SerifFont">avares://AstroProjectForge/Assets/Fonts#Instrument Serif</FontFamily>
    <RadialGradientBrush x:Key="BrandGlowBrush">
      <GradientStop Color="#8C9DB8FF" Offset="0"/>
      <GradientStop Color="#009DB8FF" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="RailBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#B3080C1C" Offset="0"/>
      <GradientStop Color="#80060914" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NextBrush" StartPoint="0%,30%" EndPoint="100%,70%">
      <GradientStop Color="#B6F3FF" Offset="0"/>
      <GradientStop Color="#9DB8FF" Offset="0.45"/>
      <GradientStop Color="#D5B0FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NextHoverBrush" StartPoint="0%,30%" EndPoint="100%,70%">
      <GradientStop Color="#CCF7FF" Offset="0"/>
      <GradientStop Color="#B3C8FF" Offset="0.45"/>
      <GradientStop Color="#E0C4FF" Offset="1"/>
    </LinearGradientBrush>
    <BoxShadows x:Key="NextGlow">0 10 40 -8 #BF9DB8FF</BoxShadows>
    <BoxShadows x:Key="NextGlowHover">0 14 50 -6 #F29DB8FF</BoxShadows>
    <LinearGradientBrush x:Key="StackShadeBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#8C04060D" Offset="0"/>
      <GradientStop Color="#0004060D" Offset="0.55"/>
      <GradientStop Color="#6604060D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FieldShadeBrush" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Color="#9904060D" Offset="0"/>
      <GradientStop Color="#0004060D" Offset="0.5"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DockBrush" Color="#8C060914"/>
    <SolidColorBrush x:Key="SheetScrimBrush" Color="#9904060D"/>
    <LinearGradientBrush x:Key="DrawerBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#F50D1430" Offset="0"/>
      <GradientStop Color="#F5080C1C" Offset="1"/>
    </LinearGradientBrush>
    <BoxShadows x:Key="DrawerShadow">0 40 120 -40 #8C5A6EFF</BoxShadows>
    <BoxShadows x:Key="CardShadow">0 18 48 0 #59000000</BoxShadows>
    <BoxShadows x:Key="PrimaryGlow">0 0 22 0 #669DB8FF</BoxShadows>
    <BoxShadows x:Key="PrimaryGlowHover">0 0 30 2 #999DB8FF</BoxShadows>

    <!-- Fluent brushes the stock controls read, recoloured for the sky. -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#8C070B18"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#B30B1128"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#E6070B18"/>
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2E96AAFF"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#52AABEFF"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#9DB8FF"/>
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#EEF1FF"/>
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#8C070B18"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#B30B1128"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2E96AAFF"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#52AABEFF"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F20B1122"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#52AABEFF"/>
    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#F20B1122"/>
    <SolidColorBrush x:Key="ToolTipBackground" Color="#F20B1122"/>
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#52AABEFF"/>
    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#2196AAFF"/>
    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#2196AAFF"/>
    <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#339DB8FF"/>
    <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#269DB8FF"/>
    <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#409DB8FF"/>
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#1796AAFF"/>
  </Styles.Resources>

  <!-- Canvas and type -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource VoidBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
    <Setter Property="FontFamily" Value="Inter"/>
  </Style>
  <Style Selector="TextBlock.display"><Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/></Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="1.4"/>
  </Style>
  <Style Selector="TextBlock.eyebrow.accent"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="LetterSpacing" Value="-0.3"/>
  </Style>
  <Style Selector="TextBlock.metricValue">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Margin" Value="0,8,0,0"/>
  </Style>
  <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="#B8C0E6"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
  <Style Selector="TextBlock.source">
    <Setter Property="Foreground" Value="{StaticResource OiiiBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="10"/>
  </Style>
  <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/></Style>
  <Style Selector="TextBlock.icon"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Style>

  <!-- Surfaces -->
  <Style Selector="Border.card, Border.metric">
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="BoxShadow" Value="{StaticResource CardShadow}"/>
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.35"/></Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.card:pointerover, Border.metric:pointerover"><Setter Property="BorderBrush" Value="{StaticResource LineHiBrush}"/></Style>
  <Style Selector="Border.card.hero"><Setter Property="Background" Value="{StaticResource HeroCardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineHiBrush}"/></Style>
  <Style Selector="Border.health">
    <Setter Property="Background" Value="{StaticResource HealthBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="16"/>
  </Style>
  <Style Selector="Border.warningBanner">
    <Setter Property="Background" Value="{StaticResource WarnCardBrush}"/>
    <Setter Property="BorderBrush" Value="#59FFC27A"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="14"/>
  </Style>
  <Style Selector="Border.pathCard">
    <Setter Property="Background" Value="#660E162C"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="9"/>
  </Style>
  <Style Selector="Border.note">
    <Setter Property="Background" Value="#80070B18"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style Selector="Border.chartCard, Border.preview">
    <Setter Property="Background" Value="#CC04060D"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style Selector="Border.iconTile">
    <Setter Property="Background" Value="{StaticResource IconTileBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineHiBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="11"/>
  </Style>
  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="{StaticResource GlassSolidBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineHiBrush}"/>
    <Setter Property="BorderThickness" Value="1,0,0,0"/>
    <Setter Property="BoxShadow" Value="-30 0 60 0 #99000000"/>
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
  </Style>
  <Style Selector="Border.rule"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{StaticResource LineBrush}"/></Style>

  <!-- Chips: counts and warnings read as instrument readouts. -->
  <Style Selector="Border.count, Border.warning">
    <Setter Property="Background" Value="{StaticResource ChipBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineHiBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="7,1"/>
    <Setter Property="Margin" Value="5,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.count > TextBlock, Border.warning > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="#C9D3F5"/>
  </Style>
  <Style Selector="Border.warning">
    <Setter Property="Background" Value="#1FFFC27A"/>
    <Setter Property="BorderBrush" Value="#73FFC27A"/>
    <Setter Property="Margin" Value="2,0"/>
  </Style>
  <Style Selector="Border.warning > TextBlock"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></Style>

  <!-- Buttons: glass by default, a lit gradient for the one action that matters. -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="#149DB8FF"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineHiBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
    <Setter Property="RenderTransform" Value="none"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="BackEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover"><Setter Property="RenderTransform" Value="translateY(-1px)"/></Style>
  <Style Selector="Button:pressed"><Setter Property="RenderTransform" Value="scale(0.97)"/></Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#299DB8FF"/>
    <Setter Property="BorderBrush" Value="#80AABEFF"/>
    <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#389DB8FF"/>
    <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#0A9DB8FF"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="Foreground" Value="#08102A"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{StaticResource PrimaryGlow}"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
    <Setter Property="Foreground" Value="#08102A"/>
    <Setter Property="BoxShadow" Value="{StaticResource PrimaryGlowHover}"/>
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="Foreground" Value="#08102A"/>
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1F9DB8FF"/>
    <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
    <Setter Property="BoxShadow" Value="none"/>
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- Workspace navigation: a glass rail with a pill that springs between tabs. -->
  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><local:SlidingPillPanel Margin="4,0"/></ItemsPanelTemplate>
    </Setter>
    <Setter Property="PageTransition"><local:SlewPageTransition/></Setter>
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
  </Style>
  <Style Selector="TabItem /template/ Border#PART_SelectedPipe"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{StaticResource FgBrush}"/></Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="TabItem:pointerover"><Setter Property="Foreground" Value="{StaticResource FgBrush}"/></Style>
  <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{StaticResource FgBrush}"/></Style>
  <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{StaticResource FgBrush}"/></Style>
  <Style Selector="TabItem:focus-visible /template/ Border#PART_LayoutRoot">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="SelectionBrush" Value="#669DB8FF"/>
  </Style>
  <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="10"/></Style>
  <Style Selector="NumericUpDown"><Setter Property="CornerRadius" Value="10"/></Style>
  <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="ListBoxItem"><Setter Property="CornerRadius" Value="10"/></Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#149DB8FF"/></Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#269DB8FF"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineHiBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#339DB8FF"/></Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter > TextBlock"><Setter Property="Foreground" Value="{StaticResource FgBrush}"/></Style>
  <Style Selector="TreeView"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="TreeViewItem"><Setter Property="CornerRadius" Value="8"/></Style>
  <Style Selector="GridSplitter"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource SpectrumBrush}"/>
    <Setter Property="Background" Value="#1F9DB8FF"/>
    <Setter Property="CornerRadius" Value="3"/>
  </Style>
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="#80070B18"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="RowBackground" Value="Transparent"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="#1496AAFF"/>
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
  </Style>
  <!-- v3 shell -->
  <Style Selector="Border.rail">
    <Setter Property="Background" Value="{StaticResource RailBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
  </Style>
  <Style Selector="Button.brand, Button.tool">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.brand:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#129DB8FF"/></Style>
  <Style Selector="Button.brand:pointerover, Button.tool:pointerover"><Setter Property="RenderTransform" Value="none"/></Style>
  <Style Selector="Button.tool">
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Margin" Value="-10,0"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.kbd">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.kbd">
    <Setter Property="BorderBrush" Value="{StaticResource LineHiBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Padding" Value="6,1"/>
  </Style>
  <Style Selector="Border.kbd > TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="10.5"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Style>
  <Style Selector="TextBlock.serif">
    <Setter Property="FontFamily" Value="{StaticResource SerifFont}"/>
    <Setter Property="FontStyle" Value="Italic"/>
  </Style>
  <Style Selector="TextBlock.serif.note"><Setter Property="FontSize" Value="20"/><Setter Property="Foreground" Value="#C9D2FF"/><Setter Property="LineHeight" Value="25"/></Style>
  <Style Selector="TextBlock.target">
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontSize" Value="34"/>
    <Setter Property="LetterSpacing" Value="-0.8"/>
    <Setter Property="MaxWidth" Value="520"/>
  </Style>
  <Style Selector="TextBlock.targetAccent"><Setter Property="FontSize" Value="36"/><Setter Property="Foreground" Value="{StaticResource OiiiBrush}"/><Setter Property="Margin" Value="0,0,0,1"/></Style>
  <Style Selector="TextBlock.bignum">
    <Setter Property="FontWeight" Value="Light"/>
    <Setter Property="FontSize" Value="72"/>
    <Setter Property="LetterSpacing" Value="-2.5"/>
  </Style>
  <Style Selector="Run.unit"><Setter Property="FontSize" Value="26"/><Setter Property="LetterSpacing" Value="0"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Style>
  <Style Selector="TextBlock.metric"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="18"/></Style>
  <Style Selector="Ellipse.live">
    <Style.Animations>
      <Animation Duration="0:0:2" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.35"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="Padding" Value="10,2"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
    <Setter Property="Background" Value="#1FFFC27A"/>
    <Setter Property="BorderBrush" Value="#73FFC27A"/>
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#33FFC27A"/><Setter Property="BorderBrush" Value="{StaticResource WarnBrush}"/><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></Style>
  <Style Selector="Border.chipOk">
    <Setter Property="BorderBrush" Value="#597CF2C9"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
  </Style>
  <Style Selector="Border.chipOk > TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="9.5"/><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></Style>

  <Style Selector="Border.tabs">
    <Setter Property="Background" Value="#990A0E1E"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="3"/>
    <Setter Property="Height" Value="44"/>
  </Style>
  <Style Selector="TabControl.screens /template/ ContentPresenter#PART_SelectedContentHost"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector="TabControl.screens TabItem"><Setter Property="MinHeight" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="14,0"/></Style>
  <Style Selector="TabControl.sheets /template/ ItemsPresenter#PART_ItemsPresenter"><Setter Property="IsVisible" Value="False"/></Style>

  <Style Selector="Button.cmdk">
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Background" Value="#990A0E1E"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
  </Style>
  <Style Selector="Button.next">
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="20,0"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#07102A"/>
    <Setter Property="Background" Value="{StaticResource NextBrush}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Button.next /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BoxShadow" Value="{StaticResource NextGlow}"/></Style>
  <Style Selector="Button.next:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource NextHoverBrush}"/>
    <Setter Property="Foreground" Value="#07102A"/>
    <Setter Property="BoxShadow" Value="{StaticResource NextGlowHover}"/>
  </Style>
  <Style Selector="Button.next:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource NextBrush}"/><Setter Property="Foreground" Value="#07102A"/></Style>
  <Style Selector="Button.next:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource NextBrush}"/><Setter Property="Foreground" Value="#07102A"/><Setter Property="Opacity" Value="0.85"/></Style>
  <Style Selector="Border.nextFill"><Setter Property="Background" Value="#2E07102A"/><Setter Property="Margin" Value="-20,0"/></Style>

  <Style Selector="Border.card.stack"><Setter Property="Background" Value="#04060D"/><Setter Property="CornerRadius" Value="20"/></Style>
  <Style Selector="Border.card.filter"><Setter Property="CornerRadius" Value="20"/></Style>
  <Style Selector="Border.dock">
    <Setter Property="Background" Value="{StaticResource DockBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="22,14,22,16"/>
  </Style>
  <Style Selector="Button.play">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.seg">
    <Setter Property="Background" Value="#B30A0E1E"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="3"/>
  </Style>
  <Style Selector="RadioButton.seg">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Seg" Background="{TemplateBinding Background}" CornerRadius="9" Padding="12,6">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.25"/></Transitions></Setter>
  </Style>
  <Style Selector="RadioButton.seg:checked"><Setter Property="Background" Value="#339DB8FF"/><Setter Property="Foreground" Value="{StaticResource FgBrush}"/></Style>
  <Style Selector="RadioButton.seg:pointerover"><Setter Property="Foreground" Value="{StaticResource FgBrush}"/></Style>

  <Style Selector="Slider.nights /template/ RepeatButton#PART_DecreaseButton"><Setter Property="Background" Value="{StaticResource SpectrumBrush}"/></Style>
  <Style Selector="Slider.nights /template/ RepeatButton#PART_DecreaseButton /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource SpectrumBrush}"/></Style>
  <Style Selector="Slider.nights:pointerover /template/ RepeatButton#PART_DecreaseButton"><Setter Property="Background" Value="{StaticResource SpectrumBrush}"/></Style>
  <Style Selector="Slider.nights /template/ Thumb"><Setter Property="Background" Value="{StaticResource FgBrush}"/></Style>
  <Style Selector="ProgressBar.goal"><Setter Property="Height" Value="4"/><Setter Property="MinHeight" Value="4"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Background" Value="#1A9DB8FF"/></Style>

  <Style Selector="ListBox.slots ListBoxItem"><Setter Property="Padding" Value="4,7"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>

  <!-- Steps: one page per step, one calm vocabulary -->
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="40"/>
    <Setter Property="FontWeight" Value="Light"/>
    <Setter Property="LetterSpacing" Value="-1.2"/>
  </Style>
  <Style Selector="TextBlock.stepTitle">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="Light"/>
    <Setter Property="LetterSpacing" Value="-0.3"/>
  </Style>
  <Style Selector="Border.card.step"><Setter Property="Padding" Value="26"/><Setter Property="CornerRadius" Value="22"/></Style>
  <Style Selector="Border.badge">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="CornerRadius" Value="17"/>
    <Setter Property="Background" Value="{StaticResource IconTileBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineHiBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.drop">
    <Setter Property="Background" Value="#0F9DB8FF"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineHiBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="20"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.3"/><BrushTransition Property="BorderBrush" Duration="0:0:0.3"/></Transitions></Setter>
  </Style>
  <Style Selector="Border.drop:pointerover"><Setter Property="Background" Value="#1C9DB8FF"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Style>

  <!-- Dragging something over the window: two large targets, the one under the pointer lights up. -->
  <Style Selector="Border.dropZone">
    <Setter Property="Background" Value="#F5080E1E"/>
    <Setter Property="CornerRadius" Value="28"/>
    <Setter Property="RenderTransform" Value="scale(0.985)"/>
    <Setter Property="Transitions"><Transitions>
      <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut"/>
      <BrushTransition Property="Background" Duration="0:0:0.2"/>
    </Transitions></Setter>
  </Style>
  <Style Selector="Border.dropZone > Grid"><Setter Property="Opacity" Value="0.5"/><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2"/></Transitions></Setter></Style>
  <Style Selector="Border.dropZone.over"><Setter Property="Background" Value="#F5102448"/><Setter Property="RenderTransform" Value="scale(1)"/></Style>
  <Style Selector="Border.dropZone.over > Grid"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="Border.dropZone Rectangle.dash"><Setter Property="Stroke" Value="{StaticResource LineHiBrush}"/><Setter Property="Transitions"><Transitions><BrushTransition Property="Stroke" Duration="0:0:0.2"/></Transitions></Setter></Style>
  <Style Selector="Border.dropZone.over Rectangle.dash"><Setter Property="Stroke" Value="{StaticResource AccentBrush}"/></Style>
  <Style Selector="Border.dropZone.marching Rectangle.dash">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="StrokeDashOffset" Value="-14"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Button.setupChip">
    <Setter Property="Background" Value="#B30A0E1E"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="13,9"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>
  <Style Selector="Button.setupChip:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#169DB8FF"/></Style>
  <Style Selector="Button.setupChip.selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#339DB8FF"/><Setter Property="BorderBrush" Value="#999DB8FF"/></Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="9,4"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#169DB8FF"/><Setter Property="Foreground" Value="{StaticResource FgBrush}"/></Style>
  <Style Selector="Button.link:pointerover"><Setter Property="RenderTransform" Value="none"/></Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.icon:pointerover"><Setter Property="RenderTransform" Value="none"/></Style>

  <Style Selector="Border.novelty">
    <Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%"><GradientStop Color="#2B3FE0D0" Offset="0"/><GradientStop Color="#140E162C" Offset="0.7"/></LinearGradientBrush></Setter>
    <Setter Property="BorderBrush" Value="#593FE0D0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="16,9"/>
    <Setter Property="BoxShadow" Value="0 8 30 -12 #663FE0D0"/>
  </Style>

  <Style Selector="Border.drawer">
    <Setter Property="Background" Value="{StaticResource DrawerBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineHiBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="22"/>
    <Setter Property="BoxShadow" Value="{StaticResource DrawerShadow}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Button.close">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="17"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.palette">
    <Setter Property="Background" Value="{StaticResource GlassSolidBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineHiBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="10"/>
    <Setter Property="BoxShadow" Value="{StaticResource DrawerShadow}"/>
  </Style>
  <Style Selector="TextBox.palette"><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="14,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="TextBox.palette:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="ListBox.palette ListBoxItem"><Setter Property="Padding" Value="14,9"/></Style>
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{StaticResource GlassSolidBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineHiBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="BoxShadow" Value="{StaticResource CardShadow}"/>
  </Style>
</Styles>
